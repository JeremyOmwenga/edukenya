# Hero
#: landing/templates/landing/index.html
msgid "Made for CBC Grades 7 and 8"
msgstr "Imeundwa kwa Gredi 7 na 8 za CBC"

#: landing/templates/landing/index.html templates/partials/site_footer.html
msgid "Learning that fits you."
msgstr "Masomo yanayokufaa wewe."

#: landing/templates/landing/index.html
msgid ""
"EduKenya is a smart learning buddy that explains every CBC topic in a way "
"that makes sense to you, and checks you really get it before you move on."
msgstr ""
"EduKenya ni rafiki mwerevu wa kujifunza anayeeleza kila mada ya CBC kwa njia "
"unayoielewa, na kuhakikisha umeelewa kweli kabla ya kuendelea."

#: landing/templates/landing/index.html
msgid "See how it works"
msgstr "Tazama jinsi inavyofanya kazi"

#: landing/templates/landing/index.html
msgid "Follows the CBC curriculum"
msgstr "Inafuata mtaala wa CBC"

#: landing/templates/landing/index.html
msgid "English and Kiswahili"
msgstr "Kiingereza na Kiswahili"

#: landing/templates/landing/index.html
msgid "Students, teachers and parents"
msgstr "Wanafunzi, walimu na wazazi"

#: landing/templates/landing/index.html
msgid "A learning map showing topics linked from Grade 6 to Grade 8"
msgstr ""
"Ramani ya kujifunza inayoonyesha mada zilizounganishwa kutoka Gredi 6 hadi "
"Gredi 8"

#: landing/templates/landing/index.html
msgid "Grade 6"
