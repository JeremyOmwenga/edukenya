# Copy to .env and fill in. Never commit .env.
# DEBUG defaults to OFF: forgetting this line can never expose debug pages.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me

# Root domain. Locally "localhost" (schools open at <name>.localhost:8000).
# Production: headybegone.dpdns.org
EDUKENYA_BASE_DOMAIN=localhost
EDUKENYA_SITE_SCHEME=http
EDUKENYA_SITE_PORT=:8000

# PostgreSQL (scripts/setup_local_db.ps1 creates this role and database)
DB_NAME=edukenya
DB_USER=edukenya
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Amazon SES (see docs/aws/01-ses.md)
AWS_SES_REGION_NAME=eu-west-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=edukenya-default
DEFAULT_FROM_EMAIL=EduKenya <no-reply@headybegone.dpdns.org>
# Where "new school waiting for approval" notices go
PLATFORM_NOTIFY_EMAIL=
